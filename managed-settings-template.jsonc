{
  "_comment": "Enterprise managed-settings.json template for Claude Code. Deploy via MDM to system paths. Users cannot override these settings.",
  "_paths": {
    "macOS": "/Library/Application Support/ClaudeCode/managed-settings.json",
    "linux": "/etc/claude-code/managed-settings.json",
    "windows": "C:\\Program Files\\ClaudeCode\\managed-settings.json"
  },
  "_customize": "Review and adjust deny rules based on your organization's workflows and risk tolerance. Remove the _comment, _paths, and _customize keys before deployment.",

  "env": {
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": 1
  },

  "cleanupPeriodDays": 30,

  "permissions": {
    "disableBypassPermissionsMode": "disable",
    "defaultMode": "default",

    "deny": [
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(su:*)",
      "Bash(chmod 777:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(**/*secret*)",
      "Read(**/*credential*)",
      "Read(**/*password*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*id_rsa*)"
    ],

    "ask": [
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(ssh:*)",
      "Bash(docker:*)",
      "Bash(kubectl:*)",
      "Bash(terraform apply:*)",
      "Bash(terraform destroy:*)",
      "Bash(npm publish:*)",
      "Bash(git push:*)"
    ]
  },

  "strictKnownMarketplaces": []
}
